{
  "name": "glint-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "preinstall": "node scripts/require-pnpm.mjs",
    "predev": "node scripts/require-pnpm.mjs",
    "dev": "vite",
    "prebuild": "node scripts/require-pnpm.mjs",
    "build": "tsc --noEmit && vite build",
    "fixture:pdf": "node ../scripts/generate-reader-fixture.mjs",
    "pretest": "node scripts/require-pnpm.mjs",
    "test": "vitest run",
    "pretest:coverage": "node scripts/require-pnpm.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@phosphor-icons/react": "2.1.10",
    "i18next": "27.2.3",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
