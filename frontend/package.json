{
  "name": "glint-frontend",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/require-pnpm.mjs",
    "predev": "node scripts/require-pnpm.mjs",
    "dev": "vite",
    "prebuild": "node scripts/require-pnpm.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip",
    "fixture:pdf": "node ../scripts/generate-reader-fixture.mjs",
    "pretest": "node scripts/require-pnpm.mjs",
    "test": "vitest run",
    "pretest:coverage": "node scripts/require-pnpm.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@phosphor-icons/react": "2.1.10",
    "@wailsio/runtime": "3.1.0",
    "foliate-js": "github:johnfactotum/foliate-js#78914aef4466eb960965702401634c2cb348e9b1",
    "i18next": "27.2.3",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "18.0.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "knip": "6.48.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=26.13.1 <27",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0"
}
