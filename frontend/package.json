{
  "name": "glint-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.30.2",
      "onFail": "error"
    }
  },
  "scripts": {
    "preinstall": "node scripts/require-pnpm.mjs",
    "predev": "node scripts/require-pnpm.mjs",
    "dev": "vite",
    "prebuild": "node scripts/require-pnpm.mjs",
    "build": "tsc --noEmit && vite build",
    "fixture:pdf": "node ../scripts/generate-reader-fixture.mjs",
    "pretest": "node scripts/require-pnpm.mjs",
    "test": "vitest run",
    "pretest:coverage": "node scripts/require-pnpm.mjs",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@phosphor-icons/react": "2.1.10",
    "pdfjs-dist": "6.0.227",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "jsdom": "^28.1.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.9"
  }
}
