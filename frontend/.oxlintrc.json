{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jsx-a11y",
    "import",
    "promise",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error"
  },
  "rules": {
    "eslint/eqeqeq": "error",
    "eslint/no-console": ["error", { "allow": ["warn", "error"] }],
    "eslint/no-param-reassign": "error",
    "eslint/no-var": "error",
    "eslint/prefer-const": "error",
    "eslint/no-useless-rename": "error",
    "eslint/object-shorthand": "error",
    "eslint/prefer-template": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/strict-boolean-expressions": ["error", { "allowNullableString": true }],
    "typescript/prefer-nullish-coalescing": ["error", { "ignorePrimitives": { "string": true } }],
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/no-confusing-void-expression": ["error", { "ignoreArrowShorthand": true }],
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "import/first": "error",
    "eslint/no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/bindings/**"],
            "message": "Call Wails bindings through the api.ts of a feature or src/shared/api."
          }
        ]
      }
    ],
    "import/no-unassigned-import": [
      "error",
      {
        "allow": [
          "**/*.css",
          "@testing-library/**",
          "./pdfPolyfills",
          "pdfjs-dist/build/pdf.worker.min.mjs"
        ]
      }
    ],
    "react/self-closing-comp": "error",
    "react/jsx-boolean-value": "error",
    "react/jsx-curly-brace-presence": "error",
    "react/jsx-fragments": "error",
    "react/no-unknown-property": "error",
    "vitest/no-focused-tests": "error",
    "vitest/no-disabled-tests": "error",

    "react/react-in-jsx-scope": "off",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/consistent-return": "off",
    "unicorn/no-immediate-mutation": "off",
    "eslint/max-lines": "off",
    "eslint/max-lines-per-function": "off",
    "eslint/no-inline-comments": "off",
    "eslint/require-await": "off",
    "eslint/no-negated-condition": "off",
    "eslint/require-unicode-regexp": "off",
    "import/max-dependencies": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "unicorn/require-module-specifiers": "off",
    "unicorn/no-useless-undefined": ["error", { "checkArguments": false }]
  },
  "ignorePatterns": ["bindings/", "dist/", "coverage/"],
  "overrides": [
    {
      "files": ["src/shared/pdf/pdfPolyfills.ts"],
      "rules": {
        "eslint/no-extend-native": "off",
        "typescript/consistent-type-definitions": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "unicorn/consistent-function-scoping": "off"
      }
    },
    {
      "files": ["src/shared/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/bindings/**"],
                "message": "Call Wails bindings through the api.ts of a feature or src/shared/api."
              },
              {
                "group": ["**/features/**", "../app/**", "../../app/**", "../../../app/**"],
                "message": "src/shared must not import src/features or src/app."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/library/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/bindings/**"],
                "message": "Call Wails bindings through the api.ts of a feature or src/shared/api."
              },
              {
                "group": [
                  "../reader",
                  "../reader/**",
                  "../../reader",
                  "../../reader/**",
                  "**/features/reader",
                  "**/features/reader/**",
                  "../settings",
                  "../settings/**",
                  "../../settings",
                  "../../settings/**",
                  "**/features/settings",
                  "**/features/settings/**"
                ],
                "message": "A feature must not import another feature; move what they share to src/shared."
              },
              {
                "group": ["**/app/App", "../../app/**", "../../../app/**"],
                "message": "A feature must not import src/app."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/reader/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/bindings/**"],
                "message": "Call Wails bindings through the api.ts of a feature or src/shared/api."
              },
              {
                "group": [
                  "../library",
                  "../library/**",
                  "../../library",
                  "../../library/**",
                  "**/features/library",
                  "**/features/library/**",
                  "../settings",
                  "../settings/**",
                  "../../settings",
                  "../../settings/**",
                  "**/features/settings",
                  "**/features/settings/**"
                ],
                "message": "A feature must not import another feature; move what they share to src/shared."
              },
              {
                "group": ["**/app/App", "../../app/**", "../../../app/**"],
                "message": "A feature must not import src/app."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/settings/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/bindings/**"],
                "message": "Call Wails bindings through the api.ts of a feature or src/shared/api."
              },
              {
                "group": [
                  "../library",
                  "../library/**",
                  "../../library",
                  "../../library/**",
                  "**/features/library",
                  "**/features/library/**",
                  "../reader",
                  "../reader/**",
                  "../../reader",
                  "../../reader/**",
                  "**/features/reader",
                  "**/features/reader/**"
                ],
                "message": "A feature must not import another feature; move what they share to src/shared."
              },
              {
                "group": ["**/app/App", "../../app/**", "../../../app/**"],
                "message": "A feature must not import src/app."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/*/api.ts", "src/shared/api/*.ts"],
      "rules": {
        "eslint/no-restricted-imports": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["**/*.test.{ts,tsx}", "src/test/**"],
      "rules": {
        "import/first": "off",
        "oxc/no-map-spread": "off",
        "eslint/max-classes-per-file": "off",
        "eslint/no-extend-native": "off",
        "typescript/no-extraneous-class": "off",
        "typescript/no-non-null-assertion": "off",
        "vitest/no-conditional-in-test": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/require-await": "off",
        "typescript/strict-void-return": "off",
        "typescript/unbound-method": "off",
        "vitest/require-mock-type-parameters": "off"
      }
    }
  ]
}
